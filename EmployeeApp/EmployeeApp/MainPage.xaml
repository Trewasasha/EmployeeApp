<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EmployeeApp.MainPage"
             Title="Главная"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackLayout Grid.Row="0" VerticalOptions="Center" Spacing="8" Padding="24">
            <Label Text="Сотрудники" 
                   FontSize="32" FontAttributes="Bold"
                   HorizontalOptions="Center" 
                   TextColor="{StaticResource PrimaryColor}" />

            <Label Text="Управление персоналом компании" 
                   TextColor="{StaticResource SecondaryColor}" FontSize="15"
                   HorizontalOptions="Center" />
        </StackLayout>

        <!-- Кнопки управления -->
        <StackLayout Grid.Row="1" Spacing="12" Padding="24,0">
            <Button Text="Список сотрудников" 
                    Command="{Binding GoToEmployeeListCommand}" />

            <Button Text="Добавить сотрудника" 
                    Command="{Binding GoToAddEmployeeCommand}"
                    BackgroundColor="#F0F0F0" TextColor="{StaticResource PrimaryColor}" />
        </StackLayout>


    </Grid>
</ContentPage>