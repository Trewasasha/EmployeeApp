<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:EmployeeApp.Converters"
             x:Class="EmployeeApp.View.EmployeePage"
             Title="Сотрудник"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:BoolToStringConverter x:Key="BoolToStringConverter" />
            <converters:StringToColorConverter x:Key="StringToColorConverter" />

            <Style TargetType="Label" x:Key="FieldHeader">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
                <Setter Property="Margin" Value="0,8,0,2" />
            </Style>

            <Style TargetType="Label" x:Key="ErrorLabel">
                <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,2,0,4" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="20" Spacing="0">
            <!-- Имя -->
            <Label Text="ИМЯ *" Style="{StaticResource FieldHeader}" />
            <Frame Padding="0" CornerRadius="6" BorderColor="{StaticResource BorderColor}" HasShadow="False">
                <Entry Text="{Binding CurrentEmployee.FirstName, Mode=TwoWay}" 
                       Placeholder="Введите имя" Margin="12,0"
                       BackgroundColor="{Binding FirstNameError, Converter={StaticResource StringToColorConverter}}" />
            </Frame>
            <Label Text="{Binding FirstNameError}" Style="{StaticResource ErrorLabel}" 
                   IsVisible="{Binding FirstNameError, Converter={StaticResource StringToBoolConverter}}" />

            <!-- Фамилия -->
            <Label Text="ФАМИЛИЯ *" Style="{StaticResource FieldHeader}" />
            <Frame Padding="0" CornerRadius="6" BorderColor="{StaticResource BorderColor}" HasShadow="False">
                <Entry Text="{Binding CurrentEmployee.LastName, Mode=TwoWay}" 
                       Placeholder="Введите фамилию" Margin="12,0"
                       BackgroundColor="{Binding LastNameError, Converter={StaticResource StringToColorConverter}}" />
            </Frame>
            <Label Text="{Binding LastNameError}" Style="{StaticResource ErrorLabel}" 
                   IsVisible="{Binding LastNameError, Converter={StaticResource StringToBoolConverter}}" />

            <!-- Отчество -->
            <Label Text="ОТЧЕСТВО *" Style="{StaticResource FieldHeader}" />
            <Frame Padding="0" CornerRadius="6" BorderColor="{StaticResource BorderColor}" HasShadow="False">
                <Entry Text="{Binding CurrentEmployee.MiddleName, Mode=TwoWay}" 
                       Placeholder="Введите отчество" Margin="12,0"
                       BackgroundColor="{Binding MiddleNameError, Converter={StaticResource StringToColorConverter}}" />
            </Frame>
            <Label Text="{Binding MiddleNameError}" Style="{StaticResource ErrorLabel}" 
                   IsVisible="{Binding MiddleNameError, Converter={StaticResource StringToBoolConverter}}" />

            <!-- Дата рождения -->
            <Label Text="ДАТА РОЖДЕНИЯ *" Style="{StaticResource FieldHeader}" />
            <Frame Padding="0" CornerRadius="6" BorderColor="{StaticResource BorderColor}" HasShadow="False">
                <DatePicker Date="{Binding CurrentEmployee.BirthDate, Mode=TwoWay}" 
                            MaximumDate="{x:Static sys:DateTime.Now}" Format="D" Margin="12,0"
                            BackgroundColor="{Binding BirthDateError, Converter={StaticResource StringToColorConverter}}" />
            </Frame>
            <Label Text="{Binding BirthDateError}" Style="{StaticResource ErrorLabel}" 
                   IsVisible="{Binding BirthDateError, Converter={StaticResource StringToBoolConverter}}" />

            <!-- Компания -->
            <Label Text="КОМПАНИЯ" Style="{StaticResource FieldHeader}" />
            <Frame Padding="0" CornerRadius="6" BorderColor="{StaticResource BorderColor}" HasShadow="False">
                <Picker ItemsSource="{Binding CompanyNames}" 
                        SelectedItem="{Binding CurrentEmployee.Company, Mode=TwoWay}"
                        Title="Выберите компанию" Margin="12,0" />
            </Frame>

            <!-- Должность -->
            <Label Text="ДОЛЖНОСТЬ" Style="{StaticResource FieldHeader}" Margin="0,12,0,2" />
            <Frame Padding="0" CornerRadius="6" BorderColor="{StaticResource BorderColor}" HasShadow="False">
                <Picker ItemsSource="{Binding PositionTitles}" 
                        SelectedItem="{Binding CurrentEmployee.Position, Mode=TwoWay}"
                        Title="Выберите должность" Margin="12,0" />
            </Frame>

            <!-- Телефон -->
            <Label Text="ТЕЛЕФОН" Style="{StaticResource FieldHeader}" Margin="0,12,0,2" />
            <Frame Padding="0" CornerRadius="6" BorderColor="{StaticResource BorderColor}" HasShadow="False">
                <Entry Text="{Binding CurrentEmployee.PhoneNumber, Mode=TwoWay}" 
                       Placeholder="+7(XXX)XXX-XX-XX" Keyboard="Telephone" Margin="12,0"
                       BackgroundColor="{Binding PhoneNumberError, Converter={StaticResource StringToColorConverter}}" />
            </Frame>
            <Label Text="{Binding PhoneNumberError}" Style="{StaticResource ErrorLabel}" 
                   IsVisible="{Binding PhoneNumberError, Converter={StaticResource StringToBoolConverter}}" />

            <!-- Сообщение об ошибке -->
            <Frame BackgroundColor="#FFF0F0" CornerRadius="6" Padding="12" Margin="0,12,0,0" HasShadow="False" BorderColor="#FFCDD2"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorColor}" FontSize="13" />
            </Frame>

            <!-- Кнопки управления -->
            <StackLayout Spacing="8" Margin="0,24,0,12">
                <!-- Главная кнопка Сохранить с явным контрастным фоном -->
                <Button Text="Сохранить" 
                        Command="{Binding SaveCommand}" 
                        BackgroundColor="{StaticResource PrimaryColor}"
                        TextColor="White"
                        IsEnabled="{Binding IsFormValid}" />

                <Button Text="Отмена" 
                        Command="{Binding CancelCommand}" 
                        BackgroundColor="#E0E0E0" 
                        TextColor="{StaticResource PrimaryColor}" />

                <Button Text="Удалить сотрудника" 
                        Command="{Binding DeleteCommand}" 
                        BackgroundColor="Transparent" 
                        TextColor="{StaticResource ErrorColor}" 
                        IsEnabled="{Binding IsDeleteEnabled}"
                        IsVisible="{Binding IsEditMode}" />
            </StackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}" 
                               Color="{StaticResource PrimaryColor}"
                               VerticalOptions="Center" />
        </StackLayout>
    </ScrollView>
</ContentPage>