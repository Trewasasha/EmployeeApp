<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EmployeeApp.View.EmployeeListPage"
             Title="Сотрудники"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <Grid Grid.Row="0" Padding="16,12" BackgroundColor="{StaticResource SurfaceColor}">
            <Label Text="Список" FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryColor}"
                   VerticalOptions="Center" HorizontalOptions="Start" />

            <Button Text="+ Добавить" Command="{Binding AddEmployeeCommand}"
                    HeightRequest="36" WidthRequest="110" CornerRadius="6"
                    HorizontalOptions="End" FontSize="13" />
        </Grid>

        <!-- Список карточек -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     Padding="16,8">
            <ListView ItemsSource="{Binding Employees}" 
                      SelectedItem="{Binding SelectedEmployee}"
                      HasUnevenRows="True"
                      SeparatorVisibility="None"
                      BackgroundColor="Transparent">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Frame Margin="0,4" Padding="16" 
                                   BackgroundColor="{StaticResource SurfaceColor}" 
                                   CornerRadius="8" HasShadow="False"
                                   BorderColor="{StaticResource BorderColor}">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" 
                                           Text="{Binding LastName}" 
                                           FontAttributes="Bold" FontSize="16" 
                                           TextColor="{StaticResource PrimaryColor}" />

                                    <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="12">
                                        <Label Text="{Binding Company}" 
                                               TextColor="{StaticResource SecondaryColor}" FontSize="13" />
                                        <Label Text="•" TextColor="#BDBDBD" FontSize="13" />
                                        <Label Text="{Binding BirthDate, StringFormat='{0:dd.MM.yyyy}'}" 
                                               TextColor="{StaticResource SecondaryColor}" FontSize="13" />
                                    </StackLayout>
                                </Grid>
                            </Frame>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </RefreshView>
    </Grid>
</ContentPage>